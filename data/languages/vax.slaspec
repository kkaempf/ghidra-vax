#--------------------------------------------------------------------------
# Spaces

define endian=little;
define alignment=1;
define space ram      type=ram_space      size=4  wordsize=1 default;
define space register type=register_space size=4;


#--------------------------------------------------------------------------
# Registers
                                     #0  4  8  c 10 14 18 1c 20 24  28  2c 30 34 38 3c
define register offset=0x00 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 AP FP SP PC ];

# processor status longword
define register offset=0x40 size=4 [ PSL ];

# processor status word
define register offset=0x40 size=2 [ _ PSW ];

# condition flags
define register offset=0x50 size=1   [ IS_F CUR_MOD PRV_MOD IPL_F DV_F FU_F IV_F T_F N_F Z_F V_F C_F ];

# 256 processor registers
define register offset=0x100 size=4 [
                               KSP   ESP   SSP   USP   ISP   PRx05 PRx06 PRx07
                               P0BR  P0LR  P1BR  P1LR  SBR   SLR   CPUID PRx0f
                               PCBB  SCBB  IPL   ASTLVL SIRR SISR  PRx16 PRx17
                               ICCS  NICR  ICR   TODR  PRx1c PRx1d PRx1e PRx1f
                               RXCS  RXDB  TXCS  TXDB  PRx24 PRx25 PRx26 PRx27
                               PRx28 PRx29 PRx2a PRx2b PRx2c PRx2d PRx2e PRx2f
                               PRx30 PRx31 PRx32 PRx33 PRx34 PRx35 PRx36 PRx37
                               MAPEN TBIA  TBIS  PRx3b PRx3c PME   SID   TBCHK
                               PRx40 PRx41 PRx42 PRx43 PRx44 PRx45 PRx46 PRx47
                               PRx48 PRx49 PRx4a PRx4b PRx4c PRx4d PRx4e PRx4f
                               PRx50 PRx51 PRx52 PRx53 PRx54 PRx55 PRx56 PRx57
                               PRx58 PRx59 PRx5a PRx5b PRx5c PRx5d PRx5e PRx5f
                               PRx60 PRx61 PRx62 PRx63 PRx64 PRx65 PRx66 PRx67
                               PRx68 PRx69 PRx6a PRx6b PRx6c PRx6d PRx6e PRx6f
                               PRx70 PRx71 PRx72 PRx73 PRx74 PRx75 PRx76 PRx77
                               PRx78 PRx79 PRx7a PRx7b PRx7c PRx7d PRx7e PRx7f
                               PRx80 PRx81 PRx82 PRx83 PRx84 PRx85 PRx86 PRx87
                               PRx88 PRx89 PRx8a PRx8b PRx8c PRx8d PRx8e PRx8f
                               PRx90 PRx91 PRx92 PRx93 PRx94 PRx95 PRx96 PRx97
                               PRx98 PRx99 PRx9a PRx9b PRx9c PRx9d PRx9e PRx9f
                               PRxa0 PRxa1 PRxa2 PRxa3 PRxa4 PRxa5 PRxa6 PRxa7
                               PRxa8 PRxa9 PRxaa PRxab PRxac PRxad PRxae PRxaf
                               PRxb0 PRxb1 PRxb2 PRxb3 PRxb4 PRxb5 PRxb6 PRxb7
                               PRxb8 PRxb9 PRxba PRxbb PRxbc PRxbd PRxbe PRxbf
                               PRxc0 PRxc1 PRxc2 PRxc3 PRxc4 PRxc5 PRxc6 PRxc7
                               PRxc8 PRxc9 PRxca PRxcb PRxcc PRxcd PRxce PRxcf
                               PRxd0 PRxd1 PRxd2 PRxd3 PRxd4 PRxd5 PRxd6 PRxd7
                               PRxd8 PRxd9 PRxda PRxdb PRxdc PRxdd PRxde PRxdf
                               PRxe0 PRxe1 PRxe2 PRxe3 PRxe4 PRxe5 PRxe6 PRxe7
                               PRxe8 PRxe9 PRxea PRxeb PRxec PRxed PRxee PRxef
                               PRxf0 PRxf1 PRxf2 PRxf3 PRxf4 PRxf5 PRxf6 PRxf7
                               PRxf8 PRxf9 PRxfa PRxfb PRxfc PRxfd PRxfe PRxff
                               ];

define register offset=0x500 size=4  [ loc statusreg ];

define context statusreg
  is_reg = (0,1) noflow
;

#--------------------------------------------------------------------------
# Macros

# -------- flags --------

macro resflags(result) {
 N_F = result s< 0;
 Z_F = result == 0;
}

macro resfflags(result) {
 N_F = result f< 0;
 Z_F = result f== 0;
}

macro addflags(op1,op2) {
 C_F = carry(op1,op2);
 V_F = scarry(op1,op2);
}

macro addcflags(op1,op2,cf) {
 C_F = carry(op1,op2) || carry(op1+op2, cf);
 V_F = scarry(op1,op2) ^^ scarry(op1+op2, cf);
}

macro subcflags(op1,op2,cf) { # FIXME ?
 C_F = (op1 < op2) || (op1-op2-cf s< 0);
 V_F = sborrow(op1,op2) ^^ sborrow(op1-op2, cf);
}

macro subflags(op1,op2) {
 C_F = op1 < op2;
 V_F = sborrow(op1,op2);
}

macro cmpflags(op1,op2) {
 C_F = op1 < op2;
 N_F = op1 s< op2;
 Z_F = op1 == op2;
 V_F = 0;
}

macro cmpfflags(op1,op2) {
 N_F = op1 f< op2;
 Z_F = op1 f== op2;
 V_F = 0;
 C_F = 0;
}

# -------- memory access --------

macro pushl(val) {
  SP = SP - 4;
  *:4 SP = val;
}

macro popl(ret) {
  ret = *:4 SP;
  SP = SP + 4;
}

macro mem_bread(dest,addr) {
  ptr:4 = addr;
  dest = *:1 ptr;
}

macro mem_wread(dest,addr) {
  ptr:4 = addr;
  dest = *:2 ptr;
}

macro mem_lread(dest,addr) {
  ptr:4 = addr;
  dest = *:4 ptr;
}

macro mem_qread(dest,addr) {
  ptr:4 = addr;
  dest = *:8 ptr;
}

macro mem_bwrite(addr, val) {
  ptr:4 = addr;
  *:1 ptr = val;
}

macro mem_wwrite(addr, val) {
  ptr:4 = addr;
  *:2 ptr = val;
}

macro mem_lwrite(addr, val) {
  ptr:4 = addr;
  *:4 ptr = val;
}

macro mem_qwrite(addr, val) {
  ptr:4 = addr;
  *:8 ptr = val;
}

# -------- bitfield access --------

# get bitfield(addr.ab, pos.rl, size.rb) into f.wl
macro get_field(f, pos, siz, addr, signed_flag) {
  local is_signed:1 = signed_flag;
  local size:1 = siz; # might be constant
  if (size != 0) goto <size_nonzero>;
  # size is zero
  f = 0;
  goto <exit_get_field>;
<size_nonzero>
  local val:4 = 0;
  local mask:4 = -1;
  local bitpos:1 = pos[0,3];  # compute bit position (0..7)
  local byteptr:4 = addr + (pos[3,29] >> 3); # compute byte position: 29 bits, counting from 3
  mem_lread(val, byteptr);
  val = val >> bitpos;
  # leave 'size' bits 1 in mask
  mask = mask >> (32 - size);
  f = val & mask;
  if (is_signed == 0) goto <exit_get_field>; # exit if not signed
  # sign extend
  mask = 1 << (size - 1); # mask for highest bit
  if ((f & mask) == 0) goto <exit_get_field>;
  mask = -1 << size;
  f = f | mask;
<exit_get_field>
}

#  insert_field(0, rl, 1, oab);

# insert bitfield (src, pos, size) into addr
macro insert_field(src, pos, siz, addr) {
  local size:1 = siz; # might be constant
  if (size == 0) goto <exit_insert_field>; # nothing to insert
  local val:4 = src; # might be constant
  local quad:8 = 0;
  local bitpos:1 = pos[0,3];  # compute bit position (0..7)
  local ptr:4 = addr + (pos[3,29] >> 3); # compute byte position: 29 bits, counting from 3
  mem_qread(quad, ptr);
  local mask:4 = -1;
  # leave 'size' bits 1 in mask
  mask = mask >> (32 - zext(size));
  local bmask:4 = -1;
  # leave 'pos' bits 1 in mask
  # use bmask to 'shift 1 bits from the right'
  bmask = bmask >> (32 - pos);
  quad = quad & sext(((~mask) << pos) | bmask); # set field bits to zero, right bits to 1
  quad = quad | zext(val << pos); # insert src
  # write result back
  mem_qwrite(ptr, quad);
<exit_insert_field>
}

macro find_first(findpos, field, size, ffs) {
  local state:1 = ffs;
  local tmp2:1 = 0;
  local mask:4 = 1;
<find_first_loop>
  if (tmp2 > (size:1 - 1)) goto <find_first_exit>;
  if ((field & mask) == 0) goto <bit_is_clear>;
  if (state == 1) goto <find_first_found>;
  goto <find_first_next>;
<bit_is_clear>
  if (state == 0) goto <find_first_found>;
<find_first_next>
  tmp2 = tmp2 + 1;
  mask = mask << 1;
  goto <find_first_loop>;
<find_first_found>
  Z_F = 0;
  findpos = findpos + zext(tmp2);
<find_first_exit>
}

#--------------------------------------------------------------------------
# Tokens

# 8bit immediate - byte
define token byte (8)
        imm8  = (0,7)
        sign8 = (7,7)
        simm8 = (0,7) signed
;

# 16bit immediate - word
define token word (16)
        imm16  = ( 0,15)
        sign16 = (15,15)
        simm16 = ( 0,15) signed
;

# 32bit immediate - long
define token long (32)
        imm32  = ( 0,31)
        sign32 = (31,31)
        simm32 = ( 0,31) signed
;

# 64bit immediate - quad
define token quad (64)
        imm64  = ( 0,63)
        sign64 = (63,63)
        simm64 = ( 0,63) signed
;

# 128bit immediate - octa
define token octa (128)
        imm128  = (  0,127)
        sign128 = (127,127)
        simm128 = (  0,127) signed
;

# opcode
define token opbyte (8)
        opcode  = (0,7)
        lownibble = (0,3)
        highnibble = (4,7)
;

# addressing
define token addrmode (8)
        mode67  = (6,7) # literal if mode67 = 0
        literal = (0,5) # 6-bit literal unsigned
        sliteral = (0,5) signed # 6-bit literal signed
	exp     = (3,5) # floating exponent
	fra     = (0,2) # floating fraction
        mode    = (4,7) # mode
        reg     = (0,3) # register
;

# processor register
define token proc_reg (8)
        preg67  = (6,7)
        preg    = (0,5)
;

#--------------------------------------------------------------------------
# Variables

attach variables [ reg ] [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 AP FP SP PC ];

attach variables [ preg ] [ KSP   ESP   SSP   USP   ISP   PRx05 PRx06 PRx07
                            P0BR  P0LR  P1BR  P1LR  SBR   SLR   CPUID PRx0f
                            PCBB  SCBB  IPL   ASTLVL SIRR SISR  PRx16 PRx17
                            ICCS  NICR  ICR   TODR  PRx1c PRx1d PRx1e PRx1f
                            RXCS  RXDB  TXCS  TXDB  PRx24 PRx25 PRx26 PRx27
                            PRx28 PRx29 PRx2a PRx2b PRx2c PRx2d PRx2e PRx2f
                            PRx30 PRx31 PRx32 PRx33 PRx34 PRx35 PRx36 PRx37
                            MAPEN TBIA  TBIS  PRx3b PRx3c PME   SID   TBCHK
                          ];


#--------------------------------------------------------------------------
# Tables

# relative addressing modes
reladdr8:  loc is simm8   [ loc = inst_start + operand_offset + 1 + simm8; ]  { export *[ram]:4 loc; }
reladdr16: loc is simm16  [ loc = inst_start + operand_offset + 2 + simm16; ] { export *[ram]:4 loc; }
reladdr32: loc is simm32  [ loc = inst_start + operand_offset + 4 + simm32; ] { export *[ram]:4 loc; }

offset8:  simm8  is simm8  { export *[const]:1 simm8; }
offset16: simm16 is simm16 { export *[const]:2 simm16; }
offset32: simm32 is simm32 { export *[const]:4 simm32; }
offset64: simm64 is simm64 { export *[const]:8 simm64; }

# condition codes (for branch)

cc: "NEQ"  is lownibble=2 { tmp:1 = !Z_F; export tmp; }
cc: "EQL"  is lownibble=3 { tmp:1 = Z_F; export tmp; }
cc: "GTR"  is lownibble=4 { tmp:1 = !(N_F || Z_F); export tmp; }
cc: "LEQ"  is lownibble=5 { tmp:1 = (N_F || Z_F); export tmp; }
cc: "GEQ"  is lownibble=8 { tmp:1 = !N_F; export tmp; }
cc: "LSS"  is lownibble=9 { tmp:1 = N_F; export tmp; }
cc: "GTRU" is lownibble=10 { tmp:1 = !(C_F || Z_F); export tmp; }
cc: "LEQU" is lownibble=11 { tmp:1 = (C_F || Z_F); export tmp; }
cc: "VC"  is lownibble=12 { tmp:1 = !V_F; export tmp; }
cc: "VS"  is lownibble=13 { tmp:1 = V_F; export tmp; }
cc: "CC"  is lownibble=14 { tmp:1 = !C_F; export tmp; }
cc: "CS"  is lownibble=15 { tmp:1 = C_F; export tmp; }

# rx: readable operands (byte, word, long, quad)
# oax: operand address (byte, word, long, quad)
# regx: register (byte, word, long, quad)

#   0-3: literal
rb: "S^#"^literal is mode67=0 & literal    { export *[const]:1 literal; }
rsb: "S^#"^sliteral is mode67=0 & sliteral { export *[const]:1 sliteral; }
rw: "S^#"^literal is mode67=0 & literal    { export *[const]:2 literal; }
rl: "S^#"^literal is mode67=0 & literal    { export *[const]:4 literal; }
rq: "S^#"^literal is mode67=0 & literal    { export *[const]:8 literal; }
# oab, oaw, oal, oaq: fault

#   4: indexed - needs all other modes defined - see below

#   5: register
rb: reg is mode=5 & reg { local val:1 = reg:1; export val; }
rw: reg is mode=5 & reg { local val:2 = reg:2; export val; }
rl: reg is mode=5 & reg { local val:4 = reg:4; export val; }
rq: reg is mode=5 & reg { local rnext:4 = &reg + 4; local vlow:4 = reg; local vhigh:4 = *[register]rnext; local val:8 = zext(vhigh << 32) + zext(vlow); export val; }

oab: reg is mode=5 & reg [ is_reg = 1; ] { export reg; }
oaw: reg is mode=5 & reg [ is_reg = 1; ] { export reg; }
oal: reg is mode=5 & reg [ is_reg = 1; ] { export reg; }
oaq: reg is mode=5 & reg [ is_reg = 1; ] { export reg; }

#   6: register deferred
rb: (reg) is mode=6 & reg { local val:1; mem_bread(val, reg); export val; }
rw: (reg) is mode=6 & reg { local val:2; mem_wread(val, reg); export val; }
rl: (reg) is mode=6 & reg { local val:4; mem_lread(val, reg); export val; }
rq: (reg) is mode=6 & reg { local val:8; mem_qread(val, reg); export val; }
oab: (reg) is mode=6 & reg { local oa:4 = reg; export oa; }
oaw: (reg) is mode=6 & reg { local oa:4 = reg; export oa; }
oal: (reg) is mode=6 & reg { local oa:4 = reg; export oa; }
oaq: (reg) is mode=6 & reg { local oa:4 = reg; export oa; }

#   7: auto decrement
rb: -(reg) is mode=7 & reg { local val:1; reg = reg - 1; mem_bread(val, reg); export val; }
rw: -(reg) is mode=7 & reg { local val:2; reg = reg - 2; mem_wread(val, reg); export val; }
rl: -(reg) is mode=7 & reg { local val:4; reg = reg - 4; mem_lread(val, reg); export val; }
rq: -(reg) is mode=7 & reg { local val:8; reg = reg - 8; mem_qread(val, reg); export val; }
oab: -(reg) is mode=7 & reg { reg = reg - 1; local oa:4 = reg; export oa; }
oaw: -(reg) is mode=7 & reg { reg = reg - 2; local oa:4 = reg; export oa; }
oal: -(reg) is mode=7 & reg { reg = reg - 4; local oa:4 = reg; export oa; }
oaq: -(reg) is mode=7 & reg { reg = reg - 8; local oa:4 = reg; export oa; }

#   8: auto increment (reg != PC)
rb: (reg)+ is mode=8 & reg { local val:1; mem_bread(val, reg); reg = reg + 1; export val; }
rw: (reg)+ is mode=8 & reg { local val:2; mem_wread(val, reg); reg = reg + 2; export val; }
rl: (reg)+ is mode=8 & reg { local val:4; mem_lread(val, reg); reg = reg + 4; export val; }
rq: (reg)+ is mode=8 & reg { local val:8; mem_qread(val, reg); reg = reg + 8; export val; }
oab: (reg)+ is mode=8 & reg { local oa:4 = reg; reg = reg + 1; export oa; }
oaw: (reg)+ is mode=8 & reg { local oa:4 = reg; reg = reg + 2; export oa; }
oal: (reg)+ is mode=8 & reg { local oa:4 = reg; reg = reg + 4; export oa; }
oaq: (reg)+ is mode=8 & reg { local oa:4 = reg; reg = reg + 8; export oa; }

#   8: immediate mode (reg == PC)
rb: "I^#"^offset8  is mode=8 & reg=15; offset8  { export offset8; }
rsb: "I^#"^offset8 is mode=8 & reg=15; offset8  { export offset8; }
rw: "I^#"^offset16 is mode=8 & reg=15; offset16 { export offset16; }
rl: "I^#"^offset32 is mode=8 & reg=15; offset32 { export offset32; }
rq: "I^#"^offset64 is mode=8 & reg=15; offset64 { export offset64; }
oab: "I^#"^offset8  is mode=8 & reg=15; offset8  { local val:4 = sext(offset8);  export val; }
oaw: "I^#"^offset16 is mode=8 & reg=15; offset16 { local val:4 = sext(offset16); export val; }
oal: "I^#"^offset32 is mode=8 & reg=15; offset32 {                               export offset32; }
# oaq missing

# 9: autoincrement, deferred
rb: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; local val:1; mem_bread(val, oa); export val; }
rw: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; local val:2; mem_wread(val, oa); export val; }
rl: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; local val:4; mem_lread(val, oa); export val; }
rq: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; local val:8; mem_qread(val, oa); export val; }
oab: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; export oa; }
oaw: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; export oa; }
oal: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; export oa; }
oaq: @(reg)+ is mode=9 & reg { local oa:4; mem_lread(oa, reg); reg = reg + 4; export oa; }

#   9: absolute
rb: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; local val:1; mem_bread(val, oa); export val; }
rw: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; local val:2; mem_wread(val, oa); export val; }
rl: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; local val:4; mem_lread(val, oa); export val; }
rq: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; local val:8; mem_qread(val, oa); export val; }
oab: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; export oa; }
oaw: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; export oa; }
oal: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; export oa; }
oaq: "@#"^simm32 is mode=9 & reg=15; simm32 { local oa:4 = simm32; export oa; }

#   10: byte displacement
rb: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); local val:1; mem_bread(val, oa); export val; }
rw: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); local val:2; mem_wread(val, oa); export val; }
rl: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); local val:4; mem_lread(val, oa); export val; }
rq: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); local val:8; mem_qread(val, oa); export val; }
oab: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); export oa; }
oaw: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); export oa; }
oal: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); export oa; }
oaq: "B^"^offset8(reg) is mode=10 & reg; offset8 { local oa:4 = reg + sext(offset8); export oa; }

#   10: byte relative
rb: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local val:1; mem_bread(val, reladdr8); export val; }
rw: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local val:2; mem_wread(val, reladdr8); export val; }
rl: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local val:4; mem_lread(val, reladdr8); export val; }
rq: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local val:8; mem_qread(val, reladdr8); export val; }
oab: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local oa:4 = reladdr8; export oa; }
oaw: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local oa:4 = reladdr8; export oa; }
oal: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local oa:4 = reladdr8; export oa; }
oaq: "B^"^reladdr8 is mode=10 & reg=15; reladdr8 { local oa:4 = reladdr8; export oa; }

#   11: byte displacement deferred
rb: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); local val:1; mem_bread(val, oa); export val; }
rw: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); local val:2; mem_wread(val, oa); export val; }
rl: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); local val:4; mem_lread(val, oa); export val; }
rq: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); local val:8; mem_qread(val, oa); export val; }
oab: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); export oa; }
oaw: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); export oa; }
oal: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); export oa; }
oaq: "@B^"^offset8(reg) is mode=11 & reg; offset8 { local addr:4 = reg + sext(offset8); local oa:4; mem_lread(oa, addr); export oa; }

#   11: byte relative deferred
rb: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); local val:1; mem_bread(val, oa); export val; }
rw: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); local val:2; mem_wread(val, oa); export val; }
rl: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); local val:4; mem_lread(val, oa); export val; }
rq: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); local val:8; mem_qread(val, oa); export val; }
oab: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); export oa; }
oaw: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); export oa; }
oal: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); export oa; }
oaq: "@"^reladdr8 is mode=11 & reg=15; reladdr8 { local oa:4; mem_lread(oa, reladdr8); export oa; }

#   12: word displacement
rb: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); local val:1; mem_bread(val, oa); export val; }
rw: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); local val:2; mem_wread(val, oa); export val; }
rl: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); local val:4; mem_lread(val, oa); export val; }
rq: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); local val:8; mem_qread(val, oa); export val; }
oab: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); export oa; }
oaw: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); export oa; }
oal: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); export oa; }
oaq: "W^"^offset16(reg) is mode=12 & reg; offset16 { local oa:4 = reg + sext(offset16); export oa; }

#   12: word relative
rb: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local val:1; mem_bread(val, reladdr16); export val; }
rw: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local val:2; mem_wread(val, reladdr16); export val; }
rl: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local val:4; mem_lread(val, reladdr16); export val; }
rq: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local val:8; mem_qread(val, reladdr16); export val; }
oab: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local oa:4 = reladdr16; export oa; }
oaw: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local oa:4 = reladdr16; export oa; }
oal: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local oa:4 = reladdr16; export oa; }
oaq: "W^"^reladdr16 is mode=12 & reg=15; reladdr16 { local oa:4 = reladdr16; export oa; }

#   13: word displacement deferred
rb: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); local val:1; mem_bread(val, oa); export val; }
rw: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); local val:2; mem_wread(val, oa); export val; }
rl: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); local val:4; mem_lread(val, oa); export val; }
rq: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); local val:8; mem_qread(val, oa); export val; }
oab: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); export oa; }
oaw: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); export oa; }
oal: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); export oa; }
oaq: "@W^"^offset16(reg) is mode=13 & reg; offset16 { local addr:4 = reg + sext(offset16); local oa:4; mem_lread(oa, addr); export oa; }

#   13: word relative deferred
rb: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); local val:1; mem_bread(val, oa); export val; }
rw: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); local val:2; mem_wread(val, oa); export val; }
rl: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); local val:4; mem_lread(val, oa); export val; }
rq: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); local val:8; mem_qread(val, oa); export val; }
oab: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); export oa; }
oaw: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); export oa; }
oal: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); export oa; }
oaq: "@W"^reladdr16 is mode=13 & reg=15; reladdr16 { local oa:4; mem_lread(oa, reladdr16); export oa; }

#   14: long displacement
rb: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; local val:1; mem_bread(val, oa); export val; }
rw: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; local val:2; mem_wread(val, oa); export val; }
rl: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; local val:4; mem_lread(val, oa); export val; }
rq: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; local val:8; mem_qread(val, oa); export val; }
oab: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; export oa; }
oaw: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; export oa; }
oal: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; export oa; }
oaq: "L^"^offset32(reg) is mode=14 & reg; offset32 { local oa:4 = reg + offset32; export oa; }

#   14: long relative
rb: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local val:1; mem_bread(val, reladdr32); export val; }
rw: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local val:2; mem_wread(val, reladdr32); export val; }
rl: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local val:4; mem_lread(val, reladdr32); export val; }
rq: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local val:8; mem_qread(val, reladdr32); export val; }
oab: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local oa:4 = reladdr32; export oa; }
oaw: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local oa:4 = reladdr32; export oa; }
oal: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local oa:4 = reladdr32; export oa; }
oaq: "L^"^reladdr32 is mode=14 & reg=15; reladdr32 { local oa:4 = reladdr32; export oa; }

#   15: long displacement deferred
rb: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); local val:1; mem_bread(val, oa); export val; }
rw: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); local val:2; mem_wread(val, oa); export val; }
rl: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); local val:4; mem_lread(val, oa); export val; }
rq: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); local val:8; mem_qread(val, oa); export val; }
oab: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); export oa; }
oaw: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); export oa; }
oal: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); export oa; }
oaq: "@L^"^offset32(reg) is mode=15 & reg; offset32 { local addr:4 = reg + offset32; local oa:4; mem_lread(oa, addr); export oa; }

#   15: long relative deferred
rb: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); local val:1; mem_bread(val, oa); export val; }
rw: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); local val:2; mem_wread(val, oa); export val; }
rl: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); local val:4; mem_lread(val, oa); export val; }
rq: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); local val:8; mem_qread(val, oa); export val; }
oab: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); export oa; }
oaw: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); export oa; }
oal: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); export oa; }
oaq: "@L"^reladdr32 is mode=15 & reg=15; reladdr32 { local oa:4; mem_lread(oa, reladdr32); export oa; }

oab2: oab is oab { local val:4 = oab:4; export val; }
oab3: oab is oab { local val:4 = oab:4; export val; }
oab4: oab is oab { local val:4 = oab:4; export val; }
oaw2: oaw is oaw { local val:4 = oaw:4; export val; }
oal2: oal is oal { local val:4 = oal:4; export val; }
oaq2: oaq is oaq { local val:4 = oaq:4; export val; }

# indexed
rb: oab[reg] is mode=4 & reg; oab { local oa:4 = oab + (1 * reg); local val:1; mem_bread(val, oa); export val; }
rw: oaw[reg] is mode=4 & reg; oaw { local oa:4 = oaw + (2 * reg); local val:2; mem_wread(val, oa); export val; }
rl: oal[reg] is mode=4 & reg; oal { local oa:4 = oal + (4 * reg); local val:4; mem_lread(val, oa); export val; }
rq: oaq[reg] is mode=4 & reg; oaq { local oa:4 = oaq + (8 * reg); local val:8; mem_qread(val, oa); export val; }
oab: oab2[reg] is mode=4 & reg; oab2 { local oa:4 = oab2 + (1 * reg); export oa; }
oaw: oaw2[reg] is mode=4 & reg; oaw2 { local oa:4 = oaw2 + (2 * reg); export oa; }
oal: oal2[reg] is mode=4 & reg; oal2 { local oa:4 = oal2 + (4 * reg); export oa; }
oaq: oaq2[reg] is mode=4 & reg; oaq2 { local oa:4 = oaq2 + (8 * reg); export oa; }

# 2nd or 3rd read-only operand
rb2: rb is rb { local val:1 = rb; export val; }
rb3: rb is rb { local val:1 = rb; export val; }
rw2: rw is rw { local val:2 = rw; export val; }
rw3: rw is rw { local val:2 = rw; export val; }
rl2: rl is rl { local val:4 = rl; export val; }
rl3: rl is rl { local val:4 = rl; export val; }
rl4: rl is rl { local val:4 = rl; export val; }
rl5: rl is rl { local val:4 = rl; export val; }
rq2: rq is rq { local val:8 = rq; export val; }


#--------------------------------------------------------------------------
# Mnemonics

#=========================================================================
# Integer-Arithmetic and Logical Instructions
#=========================================================================

# add aligned word interlocked: add.rw, sum.mw
:ADAWI rw, oaw      is opcode=0x58; rw; oaw      { local val:2; mem_wread(val, oaw); addflags(rw, val); val = rw + val; mem_wwrite(oaw, val); resflags(val); }

# add
:ADDB2 rb, oab      is opcode=0x80; rb; oab      { local val:1; mem_bread(val, oab); addflags(rb, val); val = rb + val; mem_bwrite(oab, val); resflags(val); }
:ADDB3 rb, rb2, oab is opcode=0x81; rb; rb2; oab { local val:1;                      addflags(rb, rb2); val = rb + rb2; mem_bwrite(oab, val); resflags(val); }
:ADDW2 rw, oaw      is opcode=0xa0; rw; oaw      { local val:2; mem_wread(val, oaw); addflags(rw, val); val = rw + val; mem_wwrite(oaw, val); resflags(val); }
:ADDW3 rw, rw2, oaw is opcode=0xa1; rw; rw2; oaw { local val:2;                      addflags(rw, rw2); val = rw + rw2; mem_bwrite(oaw, val); resflags(val); }
:ADDL2 rl, oal      is opcode=0xc0; rl; oal      { local val:4; mem_lread(val, oal); addflags(rl, val); val = rl + val; mem_lwrite(oal, val); resflags(val); }
:ADDL3 rl, rl2, oal is opcode=0xc1; rl; rl2; oal { local val:4;                      addflags(rl, rl2); val = rl + rl2; mem_bwrite(oal, val); resflags(val); }

# add with carry: add.rl, sum.ml
:ADWC rl, oal is opcode=0xD8; rl; oal { local cf:4 = zext(C_F); local val:4; mem_lread(val, oal); addcflags(rl, val, cf); val = rl + val + cf; mem_lwrite(oal, val); resflags(val); }

# arithmetic shift long: cnt.rb, src.rl, dst.wl
:ASHL rsb, rl, oal is opcode=0x78; rsb; rl; oal {
  local val:4 = 0;
  # check shift count
  if (rsb s> 31) goto <result_zero>;
  if (rsb s< 30) goto <result_sign>;
  if (rsb s> 0) goto <shift_left>;
  if (rsb s< 0) goto <shift_right>;
  # rsb == 0: fallthrough to <result_zero>
<result_zero>
  mem_lwrite(oal, val);
  goto <end>;
<result_sign>
  if (rl s> 0) goto <result_zero>;
  val = -1;
  mem_lwrite(oal, val);
  goto <end>;
<shift_left>
  val = rl << rsb[0,5];
  mem_lwrite(oal, val);
  goto <end>;
<shift_right>
  rsb = -rsb;
  val = rl >> rsb[0,5];
  mem_lwrite(oal, val);
  goto <end>;
<end>
  resflags(val);
  C_F = 0;
}

# arithmetic shift quad: cnt.rb, src.rq, dst.wq
:ASHQ rsb, rq, oaq is opcode=0x79; rsb; rq; oaq {
  local val:8 = 0;
  # check shift count
  if (rsb s> 63) goto <result_zero>;
  if (rsb s< 62) goto <result_sign>;
  if (rsb s> 0) goto <shift_left>;
  if (rsb s< 0) goto <shift_right>;
  # rsb == 0: fallthrough to <result_zero>
<result_zero>
  mem_qwrite(oaq, val);
  goto <end>;
<result_sign>
  if (rq s> 0) goto <result_zero>;
  val = -1;
  mem_qwrite(oaq, val);
  goto <end>;
<shift_left>
  val = rq << rsb[0,6];
  mem_qwrite(oaq, val);
  goto <end>;
<shift_right>
  rsb = -rsb;
  val = rq >> rsb[0,6];
  mem_qwrite(oaq, val);
  goto <end>;
<end>
  resflags(val);
  C_F = 0;
}

# bit clear 2-op: mask.rx, dst.mx
:BICB2 rb, oab      is opcode=0x8a; rb; oab      { local val:1; mem_bread(val, oab); val = val & ~(rb); mem_bwrite(oab, val); resflags(val); V_F = 0; }
# bit clear 3-op: mask.rx, src.rx, dst.mx
:BICB3 rb, rb2, oab is opcode=0x8b; rb; rb2; oab { local val:1                           = rb2 & ~(rb); mem_bwrite(oab, val); resflags(val); V_F = 0; }
:BICW2 rw, oaw      is opcode=0xaa; rw; oaw      { local val:2; mem_wread(val, oaw); val = val & ~(rw); mem_wwrite(oaw, val); resflags(val); V_F = 0; }
:BICW3 rw, rw2, oaw is opcode=0xab; rw; rw2; oaw { local val:2                           = rw2 & ~(rw); mem_wwrite(oaw, val); resflags(val); V_F = 0; }
:BICL2 rl, oal      is opcode=0xca; rl; oal      { local val:4; mem_lread(val, oal); val = val & ~(rl); mem_lwrite(oal, val); resflags(val); V_F = 0; }
:BICL3 rl, rl2, oal is opcode=0xcb; rl; rl2; oal { local val:4                           = rl2 & ~(rl); mem_lwrite(oal, val); resflags(val); V_F = 0; }

# bit set 2-op: mask.rx, dst.mx
:BISB2 rb, oab      is opcode=0x88; rb; oab      { local val:1; mem_bread(val, oab); val = val | rb; mem_bwrite(oab, val); resflags(val); V_F = 0; }
# bit set 3-op: mask.rx, src.rx, dst.mx
:BISB3 rb, rb2, oab is opcode=0x89; rb; rb2; oab { local val:1                           = rb2 | rb; mem_bwrite(oab, val); resflags(val); V_F = 0; }
:BISW2 rw, oaw      is opcode=0xa8; rw; oaw      { local val:2; mem_wread(val, oaw); val = val | rw; mem_wwrite(oaw, val); resflags(val); V_F = 0; }
:BISW3 rw, rw2, oaw is opcode=0xa9; rw; rw2; oaw { local val:2                           = rw2 | rw; mem_wwrite(oaw, val); resflags(val); V_F = 0; }
:BISL2 rl, oal      is opcode=0xc8; rl; oal      { local val:4; mem_lread(val, oal); val = val | rl; mem_lwrite(oal, val); resflags(val); V_F = 0; }
:BISL3 rl, rl2, oal is opcode=0xc9; rl; rl2; oal { local val:4                           = rl2 | rl; mem_lwrite(oal, val); resflags(val); V_F = 0; }

# bit test: mask.rx, src.rx
:BITB rb, rb2 is opcode=0x93; rb; rb2 { local val:1 = rb2 & rb; resflags(val); V_F = 0; }
:BITW rw, rw2 is opcode=0xb3; rw; rw2 { local val:2 = rw2 & rw; resflags(val); V_F = 0; }
:BITL rl, rl2 is opcode=0xd3; rl; rl2 { local val:4 = rl2 & rl; resflags(val); V_F = 0; }

# clear: dst.wx
:CLRB oab is opcode=0x94; oab { local val:1 = 0; mem_bwrite(oab, val); N_F = 0; Z_F = 1; V_F = 1; }
:CLRW oaw is opcode=0xb4; oaw { local val:2 = 0; mem_wwrite(oaw, val); N_F = 0; Z_F = 1; V_F = 1; }
:CLRL oal is opcode=0xd4; oal { local val:4 = 0; mem_lwrite(oal, val); N_F = 0; Z_F = 1; V_F = 1; }
:CLRQ oaq is opcode=0x7c; oaq { local val:8 = 0; mem_qwrite(oaq, val); N_F = 0; Z_F = 1; V_F = 1; }
# octaword fixme
#:CLRO eao is opcodew=0x7CFD

# compare: src1.rx, src2.rx
:CMPB rb, rb2 is opcode=0x91; rb; rb2 { cmpflags(rb, rb2); }
:CMPW rw, rw2 is opcode=0xb1; rw; rw2 { cmpflags(rw, rw2); }
:CMPL rl, rl2 is opcode=0xD1; rl; rl2 { cmpflags(rl, rl2); }

# convert: src.rx, dst.wy
:CVTBW rb, oaw is opcode=0x99; rb; oaw { local val:2 = sext(rb);  mem_wwrite(oaw, val); resflags(val); C_F = 0; }
:CVTBL rb, oal is opcode=0x98; rb; oal { local val:4 = sext(rb);  mem_wwrite(oal, val); resflags(val); C_F = 0; }
# fixme overflow
:CVTWB rw, oab is opcode=0x33; rw; oab { local val:1 = rw[0,8];   mem_bwrite(oab, val); resflags(val); C_F = 0; }
:CVTWL rw, oal is opcode=0x32; rw; oal { local val:4 = sext(rw);  mem_wwrite(oal, val); resflags(val); C_F = 0; }
:CVTLB rl, oab is opcode=0xf6; rl; oab { local val:1 = rl[0,8];   mem_bwrite(oab, val); resflags(val); C_F = 0; }
:CVTLW rl, oaw is opcode=0xf7; rl; oaw { local val:2 = rl[0,16];  mem_wwrite(oaw, val); resflags(val); C_F = 0; }

# decrement: dif.mx
:DECB oab is opcode=0x97; oab {
  local val:1;
  mem_bread(val, oab);
  if (val == 0x80) goto <underflow>;
  if (val == 0) goto <negative>;
  val = val - 1;
  goto <end>;
<underflow>
  val = 0x7f;
  V_F = 1;
  C_F = 0;
  goto <end>;
<negative>
  val = 0xff;
  C_F = 1;
  V_F = 0;
<end>
  mem_bwrite(oab, val);
  resflags(val);
}
:DECW oaw is opcode=0xb7; oaw {
  local val:2;
  mem_wread(val, oaw);
  if (val == 0x8000) goto <underflow>;
  if (val == 0) goto <negative>;
  val = val - 1;
  goto <end>;
<underflow>
  val = 0x7fff;
  V_F = 1;
  C_F = 0;
  goto <end>;
<negative>
  val = 0xffff;
  C_F = 1;
  V_F = 0;
<end>
  mem_lwrite(oaw, val);
  resflags(val);
}
:DECL oal is opcode=0xd7; oal {
  local val:4;
  mem_lread(val, oal);
  if (val == 0x80000000) goto <underflow>;
  if (val == 0) goto <negative>;
  val = val - 1;
  goto <end>;
<underflow>
  val = 0x7fffffff;
  V_F = 1;
  C_F = 0;
  goto <end>;
<negative>
  val = 0xffffffff;
  C_F = 1;
  V_F = 0;
<end>
  mem_lwrite(oal, val);
  resflags(val);
}

# divide 2-op: divr.rx, quo.wx
# divide 3-op: divr.rx, divd.rx, quo.wx
:DIVB2 rb, oab      is opcode=0x86; rb; oab      { local val:1; mem_bread(val, oab); val = val / rb; mem_bwrite(oab, val); C_F = 0; resflags(val); } # FIXME V_F
:DIVB3 rb, rb2, oab is opcode=0x87; rb; rb2; oab { local val:1;                      val = rb2 / rb; mem_bwrite(oab, val); C_F = 0; resflags(val); } # FIXME V_F
:DIVW2 rw, oaw      is opcode=0xa6; rw; oaw      { local val:2; mem_wread(val, oaw); val = val / rw; mem_wwrite(oaw, val); C_F = 0; resflags(val); } # FIXME V_F
:DIVW3 rw, rw2, oaw is opcode=0xa7; rw; rw2; oaw { local val:2;                      val = rw2 / rw; mem_wwrite(oaw, val); C_F = 0; resflags(val); } # FIXME V_F
:DIVL2 rl, oal      is opcode=0xc6; rl; oal      { local val:4; mem_lread(val, oal); val = val / rl; mem_lwrite(oal, val); C_F = 0; resflags(val); } # FIXME V_F
:DIVL3 rl, rl2, oal is opcode=0xc7; rl; rl2; oal { local val:4;                      val = rl2 / rl; mem_lwrite(oal, val); C_F = 0; resflags(val); } # FIXME V_F

# extended divide: divr.rl, divd.rq, quo.wl, rem.wl
:EDIV rl, rq, oal, oal2 is opcode=0x7b; rl; rq; oal; oal2 { local quo:8 = sext(rl); quo = rq / sext(rl); mem_lwrite(oal, quo:4); local rem:8 = rq % sext(rl); mem_lwrite(oal2, rem:4); C_F = 0; resflags(quo); } # FIXME V_F
# extended multiply: mulr.rl, muld.rl, add.rl, prod.wq
:EMUL rl, rl2, rl3, oaq is opcode=0x7a; rl; rl2; rl3; oaq { local prod:8 = sext(rl) * sext(rl2) + sext(rl3); mem_qwrite(oaq, prod); V_F = 0; C_F = 0; resflags(prod); }

# increment
:INCB oab is opcode=0x96; oab {
  local val:1;
  mem_bread(val, oab);
  if (val == 0x7f) goto <overflow>;
  if (val == 0xff) goto <positive>;
  val = val + 1;
  goto <end>;
<overflow>
  val = 0x80;
  V_F = 1;
  C_F = 0;
  goto <end>;
<positive>
  val = 0;
  C_F = 1;
  V_F = 0;
<end>
  mem_bwrite(oab, val);
  resflags(val);
}
:INCW oaw is opcode=0xb6; oaw {
  local val:1;
  mem_wread(val, oaw);
  if (val == 0x7fff) goto <overflow>;
  if (val == 0xffff) goto <positive>;
  val = val + 1;
  goto <end>;
<overflow>
  val = 0x8000;
  V_F = 1;
  C_F = 0;
  goto <end>;
<positive>
  val = 0;
  C_F = 1;
  V_F = 0;
<end>
  mem_wwrite(oaw, val);
  resflags(val);
}
:INCL oal is opcode=0xd6; oal {
  local val:1;
  mem_lread(val, oal);
  if (val == 0x7fffffff) goto <overflow>;
  if (val == 0xffffffff) goto <positive>;
  val = val + 1;
  goto <end>;
<overflow>
  val = 0x80000000;
  V_F = 1;
  C_F = 0;
  goto <end>;
<positive>
  val = 0;
  C_F = 1;
  V_F = 0;
<end>
  mem_lwrite(oal, val);
  resflags(val);
}

# move complemented: src.rx, dst.wx
:MCOMB rb, oab is opcode=0x92; rb; oab { local val:1 = ~rb; mem_bwrite(oab, val); V_F = 0; resflags(val); }
:MCOMW rw, oaw is opcode=0xb2; rw; oaw { local val:2 = ~rw; mem_wwrite(oaw, val); V_F = 0; resflags(val); }
:MCOML rl, oal is opcode=0xd2; rl; oal { local val:4 = ~rl; mem_lwrite(oal, val); V_F = 0; resflags(val); }

# move negated: src.rx, dst.wx
:MNEGB rb, oab is opcode=0x8e; rb; oab {
  local val:1;
  if (rb == 0x80) goto <overflow>;
  val = -rb;
  goto <end>;
<overflow>
  val = rb;
<end>
  mem_bwrite(oab, val);
  V_F = 0; resflags(val);
}
:MNEGW rw, oaw is opcode=0xae; rw; oaw {
  local val:2;
  if (rw == 0x8000) goto <overflow>;
  val = -rw;
  goto <end>;
<overflow>
  val = rw;
<end>
  mem_bwrite(oaw, val);
  V_F = 0; resflags(val);
}
:MNEGL rl, oal is opcode=0xce; rl; oal {
  local val:4;
  if (rl == 0x80000000) goto <overflow>;
  val = -rl;
  goto <end>;
<overflow>
  val = rl;
<end>
  mem_lwrite(oal, val);
  V_F = 0; resflags(val);
}

# move: srx.rx, dst.wx
:MOVB rb, oab is opcode=0x90; rb; oab { mem_bwrite(oab, rb); V_F = 0; resflags(rb); }
:MOVW rw, oaw is opcode=0xb0; rw; oaw { mem_wwrite(oaw, rw); V_F = 0; resflags(rw); }
:MOVL rl, oal is opcode=0xd0; rl; oal { mem_lwrite(oal, rl); V_F = 0; resflags(rl); }
:MOVQ rq, oaq is opcode=0x7d; rq; oaq { mem_qwrite(oaq, rq); V_F = 0; resflags(rq); }
#:MOVO FIXME

# move unsigned (zero-extend) byte to word: src.rx, dst.wy
:MOVZBW rb, oaw is opcode=0x9b; rb; oaw { local val:2 = zext(rb); mem_bwrite(oaw, val); resflags(val); N_F = 0; V_F = 0; }
:MOVZBL rb, oal is opcode=0x9a; rb; oal { local val:4 = zext(rb); mem_lwrite(oal, val); resflags(val); N_F = 0; V_F = 0; }
:MOVZWL rw, oal is opcode=0x3c; rw; oal { local val:4 = zext(rw); mem_lwrite(oal, val); resflags(val); N_F = 0; V_F = 0; }

# multiply 2-op: mulr.rx, prod.mx
# multiply 3-op: mulr.rx, muld.rx, prod.mx
:MULB2 rb, oab      is opcode=0x84; rb; oab      { local val:1;  mem_bread(val, oab); val = val * rb; mem_bwrite(oab, val); C_F = 0; resflags(val); } # FIXME V_F
:MULB3 rb, rb2, oab is opcode=0x85; rb; rb2; oab { local val:1;                       val = rb2 * rb; mem_bwrite(oab, val); C_F = 0; resflags(val); } # FIXME V_F
:MULW2 rw, oaw      is opcode=0xa4; rw; oaw      { local val:2;  mem_bread(val, oaw); val = val * rw; mem_wwrite(oaw, val); C_F = 0; resflags(val); } # FIXME V_F
:MULW3 rw, rw2, oaw is opcode=0xa5; rw; rw2; oaw { local val:2;                       val = rw2 * rw; mem_wwrite(oaw, val); C_F = 0; resflags(val); } # FIXME V_F
:MULL2 rl, oal      is opcode=0xc4; rl; oal      { local val:4;  mem_bread(val, oal); val = val * rl; mem_lwrite(oal, val); C_F = 0; resflags(val); } # FIXME V_F
:MULL3 rl, rl2, oal is opcode=0xc5; rl; rl2; oal { local val:4;                       val = rl2 * rl; mem_lwrite(oal, val); C_F = 0; resflags(val); } # FIXME V_F

# push long: src.rl
:PUSHL rl is opcode=0xdd; rl { pushl(rl); V_F = 0; resflags(rl); }

# rotate long: cnt.rb(signed), src.rl, dst.wl
:ROTL rb, rl, oal is opcode=0x9c; rb; rl; oal {
  local val:4 = rl;
  if (rb s> 0) goto <rotate_left>;
  if (rb s< 0) goto <rotate_right>;
  goto <rotate_exit>;
<rotate_left>
  val = (rl << rb) | (rl >> (32-rb));
  goto <rotate_result>;
<rotate_right>
  rb = -rb;
  val = (rl >> rb) | (rl << (32-rb));
<rotate_result>
  mem_lwrite(oal, val);
<rotate_exit>
  V_F = 0;
  resflags(val);
}

# subtract with carry: sub.rl, dif.ml
:SBWC rl, oal is opcode=0xD9; rl; oal { local val:4; mem_lread(val, oal); local cf:4 = zext(C_F); subcflags(rl, val, cf); val = val - rl - cf; mem_lwrite(oal, val); resflags(val); }

# subtract 2-op: sub.rx, dif.mx
# subtract 3-op: sub.rx, min.rx, dif.wx
:SUBB2 rb, oab      is opcode=0x82; rb; oab      { local val:1; mem_bread(val, oab); subflags(rb, val); val = val - rb; mem_bwrite(oab, val); resflags(val); }
:SUBB3 rb, rb2, oab is opcode=0x83; rb; rb2; oab { local val:1;                      subflags(rb, rb2); val = rb2 - rb; mem_bwrite(oab, val); resflags(val); }
:SUBW2 rw, oaw      is opcode=0xa2; rw; oaw      { local val:2; mem_wread(val, oaw); subflags(rw, val); val = val - rw; mem_wwrite(oaw, val); resflags(val); }
:SUBW3 rw, rw2, oaw is opcode=0xa3; rw; rw2; oaw { local val:2;                      subflags(rw, rw2); val = rw2 - rw; mem_wwrite(oaw, val); resflags(val); }
:SUBL2 rl, oal      is opcode=0xc2; rl; oal      { local val:4; mem_lread(val, oal); subflags(rl, val); val = val - rl; mem_lwrite(oal, val); resflags(val); }
:SUBL3 rl, rl2, oal is opcode=0xc3; rl; rl2; oal { local val:4;                      subflags(rl, rl2); val = rl2 - rl; mem_lwrite(oal, val); resflags(val); }

# test: src.rx
:TSTB rb is opcode=0x95; rb { V_F = 0; C_F = 0; resflags(rb); }
:TSTW rw is opcode=0xb5; rw { V_F = 0; C_F = 0; resflags(rw); }
:TSTL rl is opcode=0xd5; rl { V_F = 0; C_F = 0; resflags(rl); }

# exclusive-or 2-op: mask.rx, dst.mx
# exclusive-or 3-op: mask.rx, src.rx, dst.mx
:XORB2 rb, oab      is opcode=0x8c; rb; oab      { local val:1; mem_bread(val, oab); val = val ^ rb; mem_bwrite(oab, val); V_F = 0; resflags(val); }
:XORB3 rb, rb2, oab is opcode=0x8d; rb; rb2; oab { local val:1;                      val = val ^ rb; mem_bwrite(oab, val); V_F = 0; resflags(val); }
:XORW2 rw, oaw      is opcode=0xac; rw; oaw      { local val:2; mem_wread(val, oaw); val = val ^ rw; mem_bwrite(oaw, val); V_F = 0; resflags(val); }
:XORW3 rw, rw2, oaw is opcode=0xad; rw; rw2; oaw { local val:2;                      val = val ^ rw; mem_bwrite(oaw, val); V_F = 0; resflags(val); }
:XORL2 rl, oal      is opcode=0xcc; rl; oal      { local val:4; mem_lread(val, oal); val = val ^ rl; mem_bwrite(oal, val); V_F = 0; resflags(val); }
:XORL3 rl, rl2, oal is opcode=0xcd; rl; rl2; oal { local val:4;                      val = val ^ rl; mem_bwrite(oal, val); V_F = 0; resflags(val); }

#=========================================================================
# Address Instructions
#=========================================================================

# move address: src.ax, dst.wl
:MOVAB oab, oal  is opcode=0x9e; oab; oal  { mem_lwrite(oal, oab);  V_F = 0; resflags(oab);  }
:MOVAW oaw, oal  is opcode=0x3e; oaw; oal  { mem_lwrite(oal, oaw);  V_F = 0; resflags(oaw);  }
:MOVAL oal2, oal is opcode=0xde; oal2; oal { mem_lwrite(oal, oal2); V_F = 0; resflags(oal2); }
:MOVAQ oaq, oal  is opcode=0x7e; oaq; oal  { mem_lwrite(oal, oaq);  V_F = 0; resflags(oaq);  }

# push address: src.ax
:PUSHAB oab is opcode=0x9f; oab { pushl(oab); V_F = 0; resflags(oab); }
:PUSHAW oaw is opcode=0x3f; oaw { pushl(oaw); V_F = 0; resflags(oaw); }
:PUSHAL oal is opcode=0xdf; oal { pushl(oal); V_F = 0; resflags(oal); }
:PUSHAQ oaq is opcode=0x7f; oaq { pushl(oaq); V_F = 0; resflags(oaq); }

#=========================================================================
# Variable-Length Bit-Field Instructions
#=========================================================================

# compare field: pos.rl, size.rb, base.vb, {field.rv}, src.rl
:CMPV rl, rb, oab, rl2 is opcode=0xec; rl; rb; oab; rl2 {
  local f:4;
  get_field(f, rl, rb, oab, 1);
  cmpflags(f, rl2);
}
# compare zero-extended field: pos.rl, size.rb, base.vb, {field.rv}, src.rl
:CMPZV rl, rb, oab, rl2 is opcode=0xed; rl; rb; oab; rl2 {
  local f:4;
  get_field(f, rl, rb, oab, 1);
  cmpflags(f, rl2);
}

# extract field: pos.rl, size.rb, base.vb, {field.rv}, dst.wl
:EXTV rl, rb, oab, oal is opcode=0xee; rl; rb; oab; oal {
  local f:4;
  get_field(f, rl, rb, oab, 1);
  mem_lwrite(oal, f);
  resflags(f);
}
# extract zero-extended field: pos.rl, size.rb, base.vb, {field.rv}, dst.wl
:EXTZV rl, rb, oab, oal is opcode=0xef; rl; rb; oab; oal {
  local f:4;
  get_field(f, rl, rb, oab, 0);
  mem_lwrite(oal, f);
  resflags(f);
}

# find first clear: startpos.rl, size.rb, base.vb, {field.rv}, findpos.wl
:FFC rl, rb, oab, oal is opcode=0xeb; rl; rb; oab; oal {
  N_F = 0; V_F = 0; C_F = 0; Z_F = 1;
  mem_lwrite(oal, rl);
  if (rb == 0) goto <end>;
  local f:4;
  get_field(f, rl, rb, oab, 0);
  find_first(oal, f, rl, 0);
<end>
}
# find first set: startpos.rl, size.rb, base.vb, {field.rv}, findpos.wl
:FFS rl, rb, oab, oal is opcode=0xea; rl; rb; oab; oal {
  N_F = 0; V_F = 0; C_F = 0; Z_F = 1;
  mem_lwrite(oal, rl);
  if (rb == 0) goto <end>;
  local f:4;
  get_field(f, rl, rb, oab, 0);
  find_first(oal, f, rl, 1);
<end>
}

# insert field: src.rl, pos.rl, size.rb, base.vb
:INSV rl, rl2, rb, oab is opcode=0xf0; rl; rl2; rb; oab {
  insert_field(rl, rl2, zext(rb), oab);
}

#=========================================================================
# Control Instructions
#=========================================================================

macro acb_i(limit, add, index, displ) {
  F_N = (index s< 0);
  F_Z = (index == 0);
  # F_V = {integer overflow}
  if (((add s>= 0) && (index <= limit)) ||
      ((add s< 0)  && (index >= limit)))
    goto displ;
}

macro acb_f(limit, add, index, displ) {
  F_N = (index f< 0);
  F_Z = (index == 0);
  # F_V = {integer overflow}
  if (((add f>= 0) && (index f<= limit)) ||
      ((add f< 0)  && (index f>= limit)))
    goto displ;
}

# add compare and branch: limit.rx, add.rx, index.mx, displ.bw
:ACBB rb, rb2, oab, reladdr16 is opcode=0x9d; rb; rb2; oab; reladdr16 {
  local index:1;
  mem_bread(index, oab);
  index = index + rb2;
  mem_bwrite(oab, index);
  acb_i(rb, rb2, index, reladdr16);
}
:ACBW rw, rw2, oaw, reladdr16 is opcode=0x3d; rw; rw2; oaw; reladdr16 {
  local index:2;
  mem_wread(index, oaw);
  index = index + rw2;
  mem_wwrite(oaw, index);
  acb_i(rw, rw2, index, reladdr16);
}
:ACBL rl, rl2, oal, reladdr16 is opcode=0xf1; rl; rl2; oal; reladdr16 {
  local index:4;
  mem_lread(index, oal);
  index = index + rl2;
  mem_lwrite(oal, index);
  acb_i(rl, rl2, index, reladdr16);
}
:ACBF rl, rl2, oal, reladdr16 is opcode=0x4f; rl; rl2; oal; reladdr16 {
  local index:4;
  mem_lread(index, oal);
  index = index + rl2;
  mem_lwrite(oal, index);
  acb_f(rl, rl2, index, reladdr16);
}
:ACBD rq, rq2, oaq, reladdr16 is opcode=0x6f; rq; rq2; oaq; reladdr16 {
  local index:8;
  mem_qread(index, oaq);
  index = index + rq2;
  mem_qwrite(oaq, index);
  acb_f(rq, rq2, index, reladdr16);
}

# add one and branch less than equal: limit.rl, index.ml, displ.bb
:AOBLEQ rl, oal, reladdr8 is opcode=0xf3; rl; oal; reladdr8 {
  local index:4;
  mem_lread(index, oal);
  index = index + 1;
  mem_lwrite(oal, index);
  if (index <= rl) goto reladdr8;
}
# add one and branch less than: limit.rl, index.ml, displ.bb
:AOBLSS rl, oal, reladdr8 is opcode=0xf2; rl; oal; reladdr8 {
  local index:4;
  mem_lread(index, oal);
  index = index + 1;
  mem_lwrite(oal, index);
  if (index s< rl) goto reladdr8;
}

# branch on condition: displ.bb
:B^cc reladdr8 is highnibble=1 & cc; reladdr8 {
  if (cc) goto reladdr8;
}

# branch on bit set: pos.rl, base.vb, displ.bb
:BBS rl, oab, reladdr8 is opcode=0xe0; rl; oab; reladdr8 {
  local f:4;
  get_field(f, rl, 1, oab, 0);
  if (f == 1) goto reladdr8;
}
# branch on bit clear: pos.rl, base.vb, displ.bb
:BBC rl, oab, reladdr8 is opcode=0xe1; rl; oab; reladdr8 {
  local f:4;
  get_field(f, rl, 1, oab, 0);
  if (f == 0) goto reladdr8;
}

# branch on bit set and set: pos.rl, base.vb, displ.bb
:BBSS rl, oab, reladdr8 is opcode=0xe2; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0); # get one bit, unsigned
  insert_field(1, rl, 1, oab);
   if (tmp:1 == 1) goto reladdr8;
}
# branch on bit clear and set: pos.rl, base.vb, displ.bb
:BBCS rl, oab, reladdr8 is opcode=0xe3; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0);
  insert_field(1, rl, 1, oab);
  if (tmp:1 == 0) goto reladdr8;
}
# branch on bit set and clear: pos.rl, base.vb, displ.bb
:BBSC rl, oab, reladdr8 is opcode=0xe4; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0);
  insert_field(0, rl, 1, oab);
  if (tmp:1 == 1) goto reladdr8;
}
# branch on bit clear and clear: pos.rl, base.vb, displ.bb
:BBCC rl, oab, reladdr8 is opcode=0xe5; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0);
  insert_field(0, rl, 1, oab);
  if (tmp:1 == 0) goto reladdr8;
}
# branch on bit set and set (interlocked):  pos.rl, base.vb, displ.bb
:BBSSI rl, oab, reladdr8 is opcode=0xe6; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0);
  insert_field(1, rl, 1, oab);
  if (tmp:1 == 1) goto reladdr8;
}
# branch on bit clear and clear (interlocked):  pos.rl, base.vb, displ.bb
:BBCCI rl, oab, reladdr8 is opcode=0xe7; rl; oab; reladdr8 {
  local tmp:4;
  get_field(tmp, rl, 1, oab, 0);
  insert_field(0, rl, 1, oab);
  if (tmp:1 == 0) goto reladdr8;
}

# branch on low bit set: src.rl, displ.bb
:BLBS rl, reladdr8 is opcode=0xe8; rl; reladdr8 {
  local tmp:1 = rl:1 & 0x01;
  if (tmp == 1) goto reladdr8;
}
# branch on low bit clear: src.rl, displ.bb
:BLBC rl, reladdr8 is opcode=0xe9; rl; reladdr8 {
  local tmp:1 = rl:1 & 0x01;
  if (tmp == 0) goto reladdr8;
}

# branch (byte displacement): displ.bx
:BRB reladdr8 is opcode=0x11; reladdr8 {
  goto reladdr8;
}
# branch (word displacement): displ.bx
:BRW reladdr16 is opcode=0x31; reladdr16 {
  goto reladdr16;
}

# branch to subroutine (byte displacement): displ.bb
:BSBB reladdr8 is opcode=0x10; reladdr8 {
  ptr:4 = inst_next;
  pushl(ptr);
  call [reladdr8];
}
# branch to subroutine (word displacement): displ.bw
:BSBW reladdr16 is opcode=0x30; reladdr16 {
  ptr:4 = inst_next;
  pushl(ptr);
  call [reladdr16];
}

# switch/case with jump table: selector.rx, base.rx, limit.rx, displ[0].bw,...,displ[limit].bw
:CASEB rb, rb2, rb3 is opcode=0x8f; rb; rb2; rb3 {
  local tmp = rb - rb2; # offset into jump table (of words)
  local offset:4 = 0;
  if (tmp > rb3) goto <not_lequ>; # unsigned compare !, also break out here if tmp is 'negative'
  local table:4 = inst_next;
  local idx:2 = zext(tmp) + zext(tmp); # offset table has words
  local ptr:4 = table + sext(idx); # ptr into table
  offset = sext(*:2 ptr); # get table entry
  goto <end>;
<not_lequ>
  offset = 2 * zext(rb3) + 2; # skip to end of table
<end>
  ptr = inst_next;
  ptr = ptr + offset;
  goto [ptr];
}
:CASEW rw, rw2, rw3 is opcode=0xaf; rw; rw2; rw3 {
  local tmp = rw - rw2; # offset into jump table (of words)
  local offset:4 = 0;
  if (tmp > rw3) goto <not_lequ>; # unsigned compare !, also break out here if tmp is 'negative'
  local table:4 = inst_next;
  local idx:4 = zext(tmp) + zext(tmp); # offset table has words
  local ptr:4 = table + idx; # ptr into table
  offset = sext(*:2 ptr); # get table entry
  goto <end>;
<not_lequ>
  offset = 2 * zext(rw3) + 2; # skip to end of table
<end>
  ptr = inst_next;
  ptr = ptr + offset;
  goto [ptr];
}
:CASEL rl, rl2, rl3 is opcode=0xcf; rl; rl2; rl3 {
  local tmp:4 = rl - rl2; # offset into jump table (of words)
  local offset:4 = 0;
  if (tmp > rl3) goto <not_lequ>; # unsigned compare !, also break out here if tmp is 'negative'
  local table:4 = inst_next;
  local idx:4 = tmp + tmp; # offset table has words
  local ptr:4 = table + idx; # ptr into table
  offset = sext(*:2 ptr); # get table entry
  goto <end>;
<not_lequ>
  offset = 2 * rl3 + 2; # skip to end of table
<end>
  ptr = inst_next;
  ptr = ptr + offset;
  goto [ptr];
}

# jump: dst.ab
:JMP oab is opcode=0x17; oab {
  goto [oab];
}
# jump to subroutine: dst.ab
:JSB oab is opcode=0x16; oab {
  ptr:4 = inst_next;
  pushl(ptr);
  call [oab];
}

# return from subroutine
:RSB is opcode=0x05 { popl(PC); return [PC]; }

# subtract one and branch greater than or equal: index.ml, displ.bb
:SOBGEQ oal, reladdr8 is opcode=0xf4; oal; reladdr8 {
  local index:4;
  mem_lread(index, oal);
  index = index - 1;
  mem_lwrite(oal, index);
  resflags(index);
  if (index != 0x7fffffff) goto <no_v>;
  V_F = 1;
<no_v>
  if (index s>= 0) goto reladdr8;
}
# subtract one and branch greater than: index.ml, displ.bb
:SOBGTR oal, reladdr8 is opcode=0xf5; oal; reladdr8 {
  local index:4;
  mem_lread(index, oal);
  index = index - 1;
  mem_lwrite(oal, index);
  resflags(index);
  if (index != 0x7fffffff) goto <no_v>;
  V_F = 1;
<no_v>
  if (index s> 0) goto reladdr8;
}

#=========================================================================
# Procedure-Call Instructions
#=========================================================================

# call with general argument list: arglist.ab, dst.ab
:CALLG oab, oab2 is opcode=0xfa; oab; oab2 {
  local ptr:4 = oab2 + 2;
  # FIXME
  call [ptr];
}
# call with stack argument list: numarg.rl, dst.ab
:CALLS rl, oab is opcode=0xfb; rl; oab {
  local tmp2:2;
  mem_wread(tmp2, oab);
  pushl(rl);
  local tmp1:4 = 0; #SP;
  SP = SP & (~0x03); # longword-align SP
  local mask:2 = 0b10000000000;
  local rptr:4 = 0; #&R11;
<calls_loop>
  if ((tmp2 & mask) == 0) goto <skip_push>;
  local r:4 = *[register]rptr;
  pushl(r);
<skip_push>
  rptr = rptr - 4;
  mask = mask >> 1;
  if (mask != 0) goto <calls_loop>;
  pushl(PC);
  pushl(FP);
  pushl(AP);
  N_F = 0; Z_F = 0; V_F = 0; C_F = 0;
  pushl((tmp1 & 0x03) | 0x04:4 | ((zext(tmp2) & 0b111111111111:4) << 4)); # FIMXE PSW[14:5]
  pushl(0:4);
  FP = SP;
  AP = tmp1;
  local ptr:4 = oab + 2;
  call [ptr];
}
:RET is opcode=0x04 {
  popl(PC);
  return [PC];
}


#=========================================================================
# Miscellaneous Instructions
#=========================================================================

# FIXME unpack/pack from condition flags
# bit clear/set PSW
:BICPSW rw is opcode=0xb9; rw { PSW = PSW & ~rw; }
:BISPSW rw is opcode=0xb8; rw { PSW = PSW | rw; }

# breakpoint
:BPT is opcode=0x03 unimpl

# halt
:HALT is opcode=0x00 { goto inst_start; }

# compute index: subscript.rl, low.rl, high.rl, size.rl, indexin.rl, indexout.wl
:INDEX rl, rl2, rl3, rl4, rl5, oal is opcode=0x0a; rl; rl2; rl3; rl4; rl5; oal {
  local indexout:4;
  indexout = (rl5 + rl) * rl4;
  mem_lwrite(oal, indexout);
  if ((rl s< rl2) || (rl > rl3)) goto <end>;
  resflags(indexout);
<end>
}

# move from PSL
:MOVPSL oal is opcode=0xdc; oal { mem_lwrite(oal, PSL); }

:NOP is opcode=0x01 { goto inst_next; }

# pop registers: mask.rw
:POPR rw is opcode=0xba; rw {
  if ((rw & 0x0001) == 0) goto<no_r0>;
  popl(R0);
<no_r0>
  if ((rw & 0x0002) == 0) goto<no_r1>;
  popl(R1);
<no_r1>
  if ((rw & 0x0004) == 0) goto<no_r2>;
  popl(R2);
<no_r2>
  if ((rw & 0x0008) == 0) goto<no_r3>;
  popl(R3);
<no_r3>
  if ((rw & 0x0010) == 0) goto<no_r4>;
  popl(R4);
<no_r4>
  if ((rw & 0x0020) == 0) goto<no_r5>;
  popl(R5);
<no_r5>
  if ((rw & 0x0040) == 0) goto<no_r6>;
  popl(R6);
<no_r6>
  if ((rw & 0x0080) == 0) goto<no_r7>;
  popl(R7);
<no_r7>
  if ((rw & 0x0100) == 0) goto<no_r8>;
  popl(R8);
<no_r8>
  if ((rw & 0x0200) == 0) goto<no_r9>;
  popl(R9);
<no_r9>
  if ((rw & 0x0400) == 0) goto<no_r10>;
  popl(R10);
<no_r10>
  if ((rw & 0x0800) == 0) goto<no_r11>;
  popl(R11);
<no_r11>
  if ((rw & 0x1000) == 0) goto<no_ap>;
  popl(AP);
<no_ap>
  if ((rw & 0x2000) == 0) goto<no_fp>;
  popl(FP);
<no_fp>
  if ((rw & 0x4000) == 0) goto<no_sp>;
  popl(SP);
<no_sp>
}

:PUSHR rw is opcode=0xbb; rw {
  if ((rw & 0x4000) == 0) goto<no_sp>;
  pushl(SP);
<no_sp>
  if ((rw & 0x2000) == 0) goto<no_fp>;
  pushl(FP);
<no_fp>
  if ((rw & 0x1000) == 0) goto<no_ap>;
  pushl(AP);
<no_ap>
  if ((rw & 0x0800) == 0) goto<no_r11>;
  pushl(R11);
<no_r11>
  if ((rw & 0x0400) == 0) goto<no_r10>;
  pushl(R10);
<no_r10>
  if ((rw & 0x0200) == 0) goto<no_r9>;
  pushl(R9);
<no_r9>
  if ((rw & 0x0080) == 0) goto<no_r7>;
  pushl(R7);
<no_r8>
  if ((rw & 0x0040) == 0) goto<no_r6>;
  pushl(R6);
<no_r7>
  if ((rw & 0x0100) == 0) goto<no_r8>;
  pushl(R8);
<no_r6>
  if ((rw & 0x0020) == 0) goto<no_r5>;
  pushl(R5);
<no_r5>
  if ((rw & 0x0010) == 0) goto<no_r4>;
  pushl(R4);
<no_r4>
  if ((rw & 0x0008) == 0) goto<no_r3>;
  pushl(R3);
<no_r3>
  if ((rw & 0x0004) == 0) goto<no_r2>;
  pushl(R2);
<no_r2>
  if ((rw & 0x0002) == 0) goto<no_r1>;
  pushl(R1);
<no_r1>
  if ((rw & 0x0001) == 0) goto<no_r0>;
  pushl(R0);
<no_r0>
}

# user-defined extensions
:XFC is opcode=0xfc unimpl

#=========================================================================
# Queue Instructions
#=========================================================================
# FIXME

:INSQHI oab, oaq is opcode=0x5c; oab; oaq unimpl
:INSQTI oab, oaq is opcode=0x5d; oab; oaq unimpl
:INSQUE oab, oab2 is opcode=0x0e; oab; oab2 unimpl
:REMQHI oaq, oal is opcode=0x5e; oaq; oal unimpl
:REMQTI oaq, oal is opcode=0x5f; oaq; oal unimpl
:REMQUE oab, oal is opcode=0x0f; oab; oal unimpl

#=========================================================================
# Floating-Point Instructions
#=========================================================================
# FIXME

# add f-float 2-op
:ADDF2 rl, oal is opcode=0x40; rl; oal {
  local val:4;
  mem_lread(val, oal);
  val = val f+ rl;
  mem_lwrite(oal, val);
  resfflags(oal);
  V_F = 0;
  C_F = 0;
}
# add f-float 3-op
:ADDF3 rl, rl2, oal is opcode=0x41; rl; rl2; oal {
  local val:4;
  val = rl f+ rl2;
  mem_lwrite(oal, val);
  resfflags(oal);
  V_F = 0;
  C_F = 0;
}
# add d-float 2-op
:ADDD2 rq, oaq is opcode=0x60; rq; oaq {
  local val:8;
  mem_qread(val, oaq);
  val = val f+ rq;
  mem_qwrite(oaq, val);
  resfflags(oaq);
  V_F = 0;
  C_F = 0;
}
# add d-float 3-op
:ADDD3 rq, rq2, oaq is opcode=0x61; rq; rq2; oaq {
  local val:8;
  val = rq f+ rq2;
  mem_qwrite(oaq, val);
  resfflags(oaq);
  V_F = 0;
  C_F = 0;
}

# compare f-float
:CMPF rl, rl2 is opcode=0x51; rl; rl2 {
  cmpfflags(rl,rl2);
}
# compare d-float
:CMPD rq, rq2 is opcode=0x71; rq; rq2 {
  cmpfflags(rq,rq2);
}

# convert byte to f-float
:CVTBF rb, oal is opcode=0x4c; rb; oal {
  local val:4 = int2float(rb);
  mem_lwrite(oal, val);
  resflags(val);
  C_F = 0;
}
# convert word to f-float
:CVTWF rw, oal is opcode=0x4d; rw; oal {
  local val:4 = int2float(rw);
  mem_lwrite(oal, val);
  resflags(val);
  C_F = 0;
}
# convert long to f-float
:CVTLF rl, oal is opcode=0x4e; rl; oal {
  local val:4 = int2float(rl);
  mem_lwrite(oal, val);
  resflags(val);
  C_F = 0;
}
# convert byte to d-float
:CVTBD rb, oaq is opcode=0x6c; rb; oaq {
  local val:8 = int2float(rb);
  mem_qwrite(oaq, val);
  resflags(val);
  C_F = 0;
}
# convert word to d-float
:CVTWD rw, oaq is opcode=0x6d; rw; oaq {
  local val:8 = int2float(rw);
  mem_qwrite(oaq, val);
  resflags(val);
  C_F = 0;
}
# convert long to d-float
:CVTLD rl, oaq is opcode=0x6e; rl; oaq {
  local val:8 = int2float(rl);
  mem_qwrite(oaq, val);
  resflags(val);
  C_F = 0;
}
# convert f-float to byte
:CVTFB rl, oab is opcode=0x48; rl; oab {
  local val:1 = trunc(rl);
  mem_bwrite(oab, val);
  resflags(val);
  C_F = 0;
}
:CVTFW rl, oaw is opcode=0x49; rl; oaw {
  local val:2 = trunc(rl);
  mem_wwrite(oaw, val);
  resflags(val);
  C_F = 0;
}
:CVTFL rl, oal is opcode=0x4a; rl; oal {
  local val:4 = trunc(rl);
  mem_lwrite(oal, val);
  resflags(val);
  C_F = 0;
}
:CVTDB rq, oab is opcode=0x68; rq; oab {
  local val:1 = trunc(rq);
  mem_bwrite(oab, val);
  resflags(val);
  C_F = 0;
}
:CVTDW rq, oaw is opcode=0x69; rq; oaw {
  local val:2 = trunc(rq);
  mem_wwrite(oaw, val);
  resflags(val);
  C_F = 0;
}
:CVTDL rq, oal is opcode=0x6a; rq; oal {
  local val:4 = trunc(rq);
  mem_wwrite(oal, val);
  resflags(val);
  C_F = 0;
}
:CVTFD rl, oaq is opcode=0x56; rl; oaq {
  local val:8 = float2float(rl);
  mem_qwrite(oaq, val);
  resfflags(val);
  C_F = 0;
}
:CVTDF rq, oal is opcode=0x76; rq; oal {
  local val:4 = float2float(rq);
  mem_lwrite(oal, val);
  resfflags(val);
  C_F = 0;
}

# divide f-float 2-op: divr.rx, quo.mx
:DIVF2 rl, oal is opcode=0x46; rl; oal {
  local val:4;
  mem_lread(val, oal);
  val = val f/ rl;
  mem_lwrite(oal, val);
  resfflags(oal);
  C_F = 0;
}
# divide f-float 3-op: divr.rx, divd.rx, quo.mx
:DIVF3 rl, rl2, oal is opcode=0x47; rl; rl2; oal {
  local val:4;
  val = rl2 f/ rl;
  mem_lwrite(oal, val);
  resfflags(oal);
  C_F = 0;
}

# divide d-float 2-op: divr.rx, quo.mx
:DIVD2 rq, oaq is opcode=0x66; rq; oaq {
  local val:8;
  mem_qread(val, oaq);
  val = val f/ rq;
  mem_qwrite(oaq, val);
  resfflags(val);
  C_F = 0;
}
# divide f-float 3-op: divr.rx, divd.rx, quo.mx
:DIVD3 rq, rq2, oaq is opcode=0x67; rq; rq2; oaq {
  local val:8;
  val = rq2 f/ rq;
  mem_qwrite(oaq, val);
  resfflags(val);
  C_F = 0;
}

# extended f-float multiply and integerize: mulr.rx, mulrx.rb, muld.rx, int.wl, fract.wx
:EMODF rl, rb, rl2, oal, oal2 is opcode=0x54; rl; rb; rl2; oal; oal2 {
  local mulrx:8;
  mulrx = sext(rl << 8) + sext(rb);
  local product:8;
  product = sext(rl2) f* sext(mulrx);
  local intw:4;
  intw = trunc(product);
  mem_lwrite(oal, intw);
  local ffract:8 = 0;
  local fintw:8 = int2float(intw);
  ffract = product - fintw;
  local fract:4 = float2float(ffract);
  mem_lwrite(oal2, fract);
  resfflags(fract);
  C_F = 0;
}

# extended d-float multiply and integerize: mulr.rx, mulrx.rb, muld.rx, int.wl, fract.wx
:EMODD rq, rb, rq2, oal, oaq is opcode=0x74; rq; rb; rq2; oal; oaq {
  local mulrx:8;
  mulrx = sext(rq << 8) + sext(rb);
  local product:16;
  product = sext(rq2) f* sext(mulrx);
  local intw:4;
  intw = trunc(product);
  mem_lwrite(oal, intw);
  local dfract:16 = 0;
  local fintw:16 = int2float(intw);
  dfract = product - fintw;
  local fract:4 = float2float(dfract);
  mem_lwrite(oaq, fract);
  resfflags(fract);
  C_F = 0;
}

# move negated f-float: src.rx, dst.wx
:MNEGF rl, oal is opcode=0x52; rl; oal {
  local val:4 = -rl;
  mem_lwrite(oal, val);
  resfflags(val);
  C_F = 0;
  V_F = 0;
}
:MNEGD rq, oaq is opcode=0x72; rq; oaq {
  local val:8 = -rq;
  mem_qwrite(oaq, val);
  resfflags(val);
  C_F = 0;
  V_F = 0;
}

# move f-float: src.rx, dst.wx
:MOVF rl, oal is opcode=0x50; rl; oal {
  mem_lwrite(oal, rl);
  resfflags(rl);
  V_F = 0;
}
:MOVD rq, oaq is opcode=0x70; rq; oaq {
  mem_qwrite(oaq, rq);
  resfflags(rq);
  V_F = 0;
}

# multiply f-float 2-op: mulr.rx, prod.mx
:MULF2 rl, oal is opcode=0x44; rl; oal {
  local val:4;
  mem_lread(val, oal);
  val = val f* rl;
  mem_lwrite(oal, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}
# multiply f-float 3-op: mulr.rx, muld.rx, prod.wx
:MULF3 rl, rl2, oal is opcode=0x45; rl; rl2; oal {
  local val:4;
  val = rl f* rl2;
  mem_lwrite(oal, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}

# multiply d-float 2-op: mulr.rx, prod.mx
:MULD2 rq, oaq is opcode=0x64; rq; oaq {
  local val:8;
  mem_qread(val, oaq);
  val = val f* rq;
  mem_lwrite(oaq, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}
:MULD3 rq, rq2, oaq is opcode=0x65; rq; rq2; oaq {
  local val:8;
  val = rq f* rq2;
  mem_lwrite(oaq, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}

# polynomial evaluation: arg.rf, degree.rw, tbladdr.ab
:POLYF rl, rw, oab is opcode=0x55; rl; rw; oab {
  oab = 0; # FIXME
}
:POLYD rq, rw, oab is opcode=0x75; rq; rw; oab {
  oab = 0; # FIXME
}

# subtraction f-float 2-op: sub.rx, dif.mx
:SUBF2 rl, oal is opcode=0x42; rl; oal {
  local val:4;
  mem_lread(val, oal);
  val = val f- rl;
  mem_lwrite(oal, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}
# subtraction f-float 3-op: sub.rx, min.rx, dif.wx
:SUBF3 rl, rl2, oal is opcode=0x43; rl; rl2; oal {
  local val:4;
  val = rl2 f- rl;
  mem_lwrite(oal, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}
# subtraction d-float 2-op: sub.rx, dif.mx
:SUBD2 rq, oaq is opcode=0x62; rq; oaq {
  local val:8;
  mem_qread(val, oaq);
  val = val f- rq;
  mem_qwrite(oaq, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}
# subtraction d-float 3-op: sub.rx, min.rx, dif.wx
:SUBD3 rq, rq2, oaq is opcode=0x63; rq; rq2; oaq {
  local val:8;
  val = rq2 f- rq;
  mem_qwrite(oaq, val);
  resfflags(val);
  V_F = 0;
  C_F = 0;
}

# test f-float
:TSTF rl is opcode=0x53; rl {
  resfflags(rl);
  V_F = 0;
  C_F = 0;
}
# test d-float
:TSTD rq is opcode=0x73; rq {
  resfflags(rq);
  V_F = 0;
  C_F = 0;
}

#=========================================================================
# Character-String Instructions
#=========================================================================
# FIXME

# compare characters: len.rw, src1addr.ab, src2addr.ab {R0-3.wl}
:CMPC3 rw, oab, oab2 is opcode=0x29; rw; oab; oab2 {
  local tmp1 = rw; # length
  local tmp2 = oab; # source 1
  local tmp4 = oab2; # source 2
  local tmpa:1 = 0; # compare regs
  local tmpb:1 = 0;
<while_loop>
  if (tmp1 == 0) goto <match>;
  tmpa = *:1 tmp2; # src 1 char
  tmpb = *:1 tmp4; # src 2 char
  if (tmpa != tmpb) goto <nomatch>;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 + 1;
  tmp4 = tmp4 + 1;
  goto <while_loop>;
<nomatch>
  Z_F = 0;
  N_F = (tmpa s< tmpb);
  C_F = (tmpa < tmpb);
  goto <while_end>;
<match>
  Z_F = 1;
  N_F = 0;
  C_F = 0;
<while_end>
  R0 = zext(tmp1);
  R1 = tmp2;
  R2 = zext(tmp1);
  R3 = tmp4;
}

#  src1len.rw, src1addr.ab, fill.rb, src2len.rw, src2addr.ab {R0-3.wl}
:CMPC5 rw, oab, rb, rw2, oab2 is opcode=0x2d; rw; oab; rb; rw2; oab2 {
  local tmp1 = rw; # src1len
  local tmp2 = oab; # src1addr
  local tmp3 = rw2; # src2len
  local tmp4 = oab2; # src2addr
  local tmpa:1 = 0; # compare regs
  local tmpb:1 = 0;
<while_loop>
  if ((tmp1 == 0) && (tmp3 == 0)) goto <match>;
  if (tmp1 == 0) goto <src1_zero>;
  tmpa = *:1 tmp2;
  goto <check_src2>;
<src1_zero>
  tmpa = oab2:1; # fill
<check_src2>
  if (tmp3 == 0) goto <src2_zero>;
  tmpb = *:1 tmp4;
  goto <check>;
<src2_zero>
  tmpb = rb; # fill
<check>
  if (tmpa != tmpb) goto <nomatch>;
  Z_F = 1;
  if (tmp1 == 0) goto <no_inc_src1>;
  tmp1 = tmp1 - 1; tmp2 = tmp2 + 1;
<no_inc_src1>
  if (tmp3 == 0) goto <while_loop>;
  tmp3 = tmp3 - 1; tmp4 = tmp4 + 1;
  goto <while_loop>;
<nomatch>
  Z_F = 0;
  N_F = (tmpa s< tmpb);
  C_F = (tmpa < tmpb);#
  goto <while_end>;
<match>
  Z_F = 1;
  N_F = 0;
  C_F = 0;
<while_end>
  R0 = zext(tmp1);
  R1 = tmp2;
  R2 = zext(tmp3);
  R3 = tmp4;
}

# locate character
#    char.rb, len.rw, addr.ab
:LOCC rb, rw, oab is opcode=0x3a; rb; rw; oab {
  local tmp1:2 = rw;
  local tmp2:4 = oab;
<while_loop>
  if (tmp1 > 0) goto <while_cont>;
  goto <while_end>;
<while_cont>
  local char = *:1 tmp2;
  if (char == rb) goto <while_end>;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 + 1;
  goto <while_loop>;
<while_end>
  Z_F = (tmp1 != 0);
  R0 = zext(tmp1);
  R1 = tmp2;
}

# match characters
#   objlen.rw, objaddr.ab, srclen.rw, srcaddr.ab
:MATCHC rw, oab, rw2, oab2 is opcode=0x39; rw; oab; rw2; oab2 {
  local tmp1 = rw;
  local tmp2 = oab;
  local tmp3 = rw2;
  local tmp4 = oab2;
  local tmp5 = tmp1;
<while_loop>
  if (tmp1 == 0) goto <while_end>;
  if (tmp3 < tmp1) goto <while_end>;
  if (tmp2 != tmp4) goto <matchc_else>;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 + 1;
  tmp3 = tmp3 - 1;
  tmp4 = tmp4 + 1;
  goto <while_loop>;
<matchc_else>
  tmp2 = tmp2 - zext(tmp5 - tmp1);
  tmp3 = (tmp3 - 1) + (tmp5 - tmp1);
  tmp4 = (tmp4 + 1) - zext(tmp5 - tmp1);
  tmp1 = tmp5;
  goto <while_loop>;
<while_end>
  if (tmp3 >= tmp1) goto <matchc_exit>;
  tmp4 = tmp4 + zext(tmp3);
  tmp3 = 0;
<matchc_exit>
  Z_F = (tmp1 == 0);
  N_F = 0;
  V_F = 0;
  C_F = 0;
  R0 = zext(tmp1);
  R1 = tmp2;
  R2 = zext(tmp3);
  R3 = tmp4;
}

# move characters
#  len.rw, srcaddr.ab, dstaddr.ab
:MOVC3 rw, oab, oab2 is opcode=0x28; rw; oab; oab2 {
  local tmp1 = rw;
  local tmp2 = oab;
  local tmp3 = oab2;
  if (tmp2 <= tmp3) goto <movc3_else>;
<first_while>
  if (tmp1 == 0) goto <first_while_done>;
  *:1 tmp3 = *:1 tmp2;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 + 1;
  tmp3 = tmp3 + 1;
  goto <first_while>;
<first_while_done>
  R1 = tmp2;
  R3 = tmp3;
  goto <end_movc3>;
<movc3_else>
  local tmp4 = tmp1;
  tmp2 = tmp2 + zext(tmp1);
  tmp3 = tmp3 + zext(tmp1);
<second_while>
  if (tmp1 == 0) goto <second_while_done>;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 - 1;
  tmp3 = tmp3 - 1;
  *:1 tmp3 = *:1 tmp2;
  goto <second_while>;
<second_while_done>
  R1 = tmp2 + zext(tmp4);
  R2 = tmp3 + zext(tmp4);
<end_movc3>
  R0 = 0;
  R2 = 0;
  R4 = 0;
  R5 = 0;
  N_F = 0;
  Z_F = 1;
  V_F = 0;
  C_F = 0;
}

# move characters 5-op:  srclen.rw, srcaddr.ab, fill.rb, dstlen.rw, dstaddr.ab
:MOVC5 rw, oab, rb, rw2, oab2 is opcode=0x2c; rw; oab; rb; rw2; oab2 {
  local tmp1 = rw;
  local tmp2 = oab;
  local tmp3 = rw2;
  local tmp4 = oab2;
  if (tmp2 <= tmp4) goto <movc5_else>;
<first_while>
  if (tmp1 == 0) goto <second_while>;
  if (tmp3 == 0) goto <second_while>;
  *:1 tmp4 = *:1 tmp2;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 + 1;
  tmp3 = tmp3 - 1;
  tmp4 = tmp4 + 1;
  goto <first_while>;
<second_while>
  if (tmp3 == 0) goto <second_while_done>;
  *:1 tmp4 = rb;
  tmp3 = tmp3 - 1;
  tmp4 = tmp4 + 1;
  goto <second_while>;
<second_while_done>
  R1 = tmp2;
  R3 = tmp4;
  goto <end_movc5>;
<movc5_else>
  local tmp5:2;
  if (tmp1 < tmp3) goto <tmp1_min>;
  tmp5 = tmp3;
  goto <tmp5_min>;
<tmp1_min>
  tmp5 = tmp1;
<tmp5_min>
  local tmp6 = tmp3;
  tmp2 = tmp2 + zext(tmp5);
  tmp4 = tmp4 + zext(tmp6);
<third_while>
  if (tmp3 <= tmp1) goto <fourth_while>;
  tmp3 = tmp3 - 1;
  tmp4 = tmp4 - 1;
  *:1 tmp4 = oab2;
  goto <third_while>;
<fourth_while>
  if (tmp3 == 0) goto <fourth_while_done>;
  tmp1 = tmp1 - 1;
  tmp2 = tmp2 - 1;
  tmp3 = tmp3 - 1;
  tmp4 = tmp4 - 1;
  *:1 tmp4 = *:1 tmp2;
  goto <fourth_while>;
<fourth_while_done>
  R1 = tmp2 + zext(tmp5);
  R2 = tmp4 + zext(tmp6);
<end_movc5>
  R0 = zext(tmp1);
  R2 = 0;
  R4 = 0;
  R5 = 0;
  N_F = (rw s< rw2);
  Z_F = (rw == rw2);
  V_F = 0;
  C_F = (rw < rw2);
}

:MOVTC rw, oab, oab2, oab3, rw2, oab4 is opcode=0x2e; rw; oab; oab2; oab3; rw2; oab4 unimpl
:MOVTUC rw, oab, oab2, oab3, rw2, oab4 is opcode=0x2f; rw; oab; oab2; oab3; rw2; oab4 unimpl
:SCANC rw, oab, oab2, rb is opcode=0x2a; rw; oab; oab2; rb unimpl
:SKPC rb, rw, oab is opcode=0x3b; rb; rw; oab unimpl
:SPANC rw, oab, oab2, rb is opcode=0x2b; rw; oab; oab2; rb unimpl

#=========================================================================
# Instructions related to exceptions and interrupts
#=========================================================================
# FIXME

:REI is opcode=0x02 unimpl
:CHMK is opcode=0xbc unimpl
:CHME is opcode=0xbd unimpl
:CHMS is opcode=0xbe unimpl
:CHMU is opcode=0xbf unimpl

#=========================================================================
# Process-Structure Instructions
#=========================================================================
# FIXME

:LDPCTX is opcode=0x06 unimpl
:SVPCTX is opcode=0x07 unimpl

procreg: preg is preg67 = 0 & preg { local tmp:4 = &preg; export tmp; }
procreg: rl is rl { local proff:4 = &rl; export proff; }

# move to processor register
:MTPR rl, procreg is opcode=0xda; rl; procreg {
  *[register]procreg = rl;
}

# move from processor register
:MFPR procreg, oal is opcode=0xdb; procreg; oal {
  local val:4 = *[register]procreg;
  mem_lwrite(oal, val);
}
